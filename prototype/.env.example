# Local development uses the Vite proxy automatically; do not set VITE_BACKEND_URL.
# Vite listens on 0.0.0.0 so other devices on the same LAN can open
# http://<your-computer-LAN-IP>:5173 (or the port supplied at startup).
VITE_BACKEND_TARGET=http://localhost:3000
# Set this only for a production deployment with a separate API origin.
# VITE_BACKEND_URL=https://api.example.com
